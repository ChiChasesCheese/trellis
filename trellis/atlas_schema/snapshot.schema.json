{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "trellis.snapshot/1",
 "title": "Atlas snapshot",
 "type": "object",
 "required": [
  "schema",
  "date",
  "domains",
  "daily"
 ],
 "properties": {
  "schema": {
   "const": "trellis.snapshot/1"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "daily": {
   "type": "object",
   "additionalProperties": {
    "type": "integer"
   }
  },
  "domains": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "cards",
     "nodes"
    ],
    "properties": {
     "cards": {
      "type": "integer"
     },
     "studied": {
      "type": "integer"
     },
     "hold": {
      "type": "number"
     },
     "nodes": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "properties": {
        "cards": {
         "type": "integer"
        },
        "studied": {
         "type": "integer"
        },
        "hold": {
         "type": "number"
        },
        "flags": {
         "type": "array",
         "items": {
          "enum": [
           "weak",
           "uncovered",
           "sealed",
           "settling"
          ]
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
