__pycache__/
*.egg-info/
dist/
.pytest_cache/
.obsidian/
# Clipped article copies ARE committed: this repo is private and personal,
# and a git clone is how the archive reaches the phone. They remain other
# people's writing — do not make this repository public again without
# removing them (`git rm -r --cached vault/*/clippings` and restoring this
# ignore rule).
.trellis/

# Browser-automation scratch output (screenshots, page snapshots) — never source
.playwright-mcp/

# A book you paid for is ingested here for triage and digest, and stays on
# this machine: the outline (titles only) is committed under sources/outlines/.
sources/local/

# Obsidian was told the vault is called Trellis_; that name is a symlink to vault/
# on this machine so both git and Obsidian keep their path (see ADR 0001 on why
# the real folder stays `vault`).
/Trellis_

# Claude Code worktrees and per-machine local settings live under .claude/; only settings.json is shared
.claude/worktrees/
.claude/settings.local.json

# Interview kits (vault/interviews/companies/*): per-machine drill state, never source
progress.jsonl
.drill.json
loop/work/
