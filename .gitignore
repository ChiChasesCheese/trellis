__pycache__/
*.pyc
target/
*.egg-info/
dist/
.pytest_cache/
.obsidian/
# The repository is public. Clipped article text (vault/**/clippings/*.md) is committed by choice;
# clipped PDFs are not: they stay in the vault on Chi's devices through Obsidian Sync (private) and
# render there via the `![[name.pdf]]` embed; `trellis clip` re-fetches them from the source URL.
vault/**/clippings/*.pdf
.trellis/

# Browser-automation scratch output (screenshots, page snapshots) — never source
.playwright-mcp/

# A book you paid for is ingested here for triage and digest, and stays on
# this machine: the outline (titles only) is committed under sources/outlines/.
sources/local/

# Obsidian was told the vault is called Trellis_; that name is a symlink to vault/
# on this machine so both git and Obsidian keep their path (see ADR 0001 on why
# the real folder stays `vault`).
/Trellis_

# Claude Code worktrees and per-machine local settings live under .claude/; only settings.json is shared
.claude/worktrees/
.claude/settings.local.json

# Interview kits (vault/interviews/companies/*): per-machine drill state, never source
progress.jsonl
.drill.json
loop/work/

# Employer evidence behind vault/interviews/core/stories/ (repo PRs, tickets, chat excerpts):
# local only, never committed — see core/Core.md
vault/interviews/core/stories/raw/

# Generated by example build scripts (build_all.sh, build_demos.sh); lessons quote the output inline
**/examples/out/

# Daily must-read deck: rebuilt from personal Anki stats by scripts/lc_mustread.py; never committed (public repo)
skeleton/leetcode-mustread.yaml
vault/interviews/core/leetcode/mustread/

# Video / image clips embedded in cards (personal study copies; shipped to Anki inside the .apkg, synced by Obsidian)
vault/domains/basketball/media/
research/domains/basketball/clips.json.lock

# Hello Interview cards written from logged-in pages: commercial site, public repo. Local vault and Anki only.
vault/domains/hello-interview/cards/premium/
vault/domains/hello-interview/premium/

# LLD study plan: personal attempts and progress
vault/interviews/core/low-level-design/work/
vault/interviews/core/low-level-design/progress.jsonl
vault/interviews/core/low-level-design/PROGRESS.md

# Bagu deck: draws directly on third-party material, so it stays on this machine and in Anki
skeleton/bagu.yaml
vault/domains/bagu/
research/domains/bagu/

# merged system-design view: includes the local-only bagu domain (Chi, 2026-11-07)
skeleton/sysdesign.yaml
research/sysdesign/
vault/domains/sysdesign/

# Private material (employer internals, interviews a company must not see): local and Anki only, never GitHub.
# Guarded by scripts/private_guard.py (git hooks) against the terms in ~/.config/trellis/private_terms.txt.
vault/private/
skeleton/private-*.yaml
research/private/

# Headlands interview prep: private, local and Anki only (Chi, 2026-11-09). Earlier history still holds it.
vault/interviews/companies/headlands/
research/companies/headlands/
vault/interviews/core/*/headlands/
skeleton/headlands.yaml

# mock interviews recorded by the sysdesign-board tool: personal, never public
vault/system_design_mocks/

# the LeetCode knowledge tree built from 0x3F (灵茶山艾府) posts: derived from his text, local only
skeleton/leetcode-tree.yaml
vault/interviews/core/leetcode/tree/
