diff --git a/src/minimako/compiler.py b/src/minimako/compiler.py
index 1f21ea1..3a78741 100644
--- a/src/minimako/compiler.py
+++ b/src/minimako/compiler.py
@@ -54,3 +54,8 @@ class Compiler:
             child = Compiler(loop_context, self.current_template)
             out.append("".join(child.visit(n) for n in node.body))
         return "".join(out)
+
+    def visit_IncludeNode(self, node: astmod.IncludeNode) -> str:
+        included = self.current_template.resolve_include(node.file)
+        child = Compiler(dict(self.context), current_template=included)
+        return child.render(included.ast)
