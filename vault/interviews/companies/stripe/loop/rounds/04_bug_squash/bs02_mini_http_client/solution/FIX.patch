diff --git a/src/minihttp/length.py b/src/minihttp/length.py
index c905999..191391c 100644
--- a/src/minihttp/length.py
+++ b/src/minihttp/length.py
@@ -43,6 +43,7 @@ def super_len(o: object) -> int | None:
         current_position = o.tell()
         o.seek(0, os.SEEK_END)
         end_position = o.tell()
+        o.seek(current_position)
         return end_position - current_position
 
     return None
diff --git a/src/minihttp/multipart.py b/src/minihttp/multipart.py
index bb9aee5..20a2f99 100644
--- a/src/minihttp/multipart.py
+++ b/src/minihttp/multipart.py
@@ -23,6 +23,8 @@ def iter_slices(data: bytes | str, slice_length: int | None = None):
     pass it explicitly; callers that just want "give me this back as an iterable" rely on the
     default.
     """
+    if not slice_length or slice_length <= 0:
+        slice_length = len(data)
     pos = 0
     while pos < len(data):
         yield data[pos : pos + slice_length]
